            "url": "https://{subdomain}.{site}/api/v2/on-call/schedules/:schedule_id/on-call",
            "params": [
              {
                "name": "include",
                "value": "example_value",
                "type": "query",
                "description": "Specifies related resources to include in the response as a comma-separated list. Allowed value: `user`."
              },
              {
                "name": "schedule_id",
                "value": "3653d3c6-0c75-11ea-ad28-fb5701eabc7d",
                "type": "path",
                "description": "The ID of the schedule."
              },
              {
                "name": "filter[at_ts]",
                "value": "2025-05-07T02:53:01Z",
                "type": "query",
                "description": "Retrieves the on-call user at the given timestamp (ISO-8601). Defaults to the current time if omitted.\""
              }

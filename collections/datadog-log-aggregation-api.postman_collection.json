      "item": [
        {
          "id": "352de920-14d5-40b1-a1fe-b85bbcaed7b7",
          "name": "Datadog Aggregate Logs",
          "request": {
            "name": "Datadog Aggregate Logs",
            "description": {
              "content": "Computes aggregations over log events matching a search query within a specified time range. Supports count, sum, avg, min, max, and percentile aggregations grouped by one or more facets. Results can be used for building analytics charts, dashboards, and reports. Useful for answering questions like \"how many errors per service per hour?\" or \"what is the p99 latency by endpoint?\".",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "logs",
                "analytics",
                "aggregate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"query\": \"<string>\",\n    \"indexes\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"from\": \"<string>\",\n    \"to\": \"<string>\"\n  },\n  \"compute\": [\n    {\n      \"aggregation\": \"<string>\",\n      \"type\": \"<string>\",\n      \"metric\": \"<string>\",\n      \"interval\": \"<string>\"\n    },\n    {\n      \"aggregation\": \"<string>\",\n      \"type\": \"<string>\",\n      \"metric\": \"<string>\",\n      \"interval\": \"<string>\"\n    }\n  ],\n  \"group_by\": [\n    {\n      \"facet\": \"<string>\",\n      \"limit\": 10,\n      \"sort\": {\n        \"aggregation\": \"<string>\",\n        \"order\": \"<string>\"\n      }\n    },\n    {\n      \"facet\": \"<string>\",\n      \"limit\": 10,\n      \"sort\": {\n        \"aggregation\": \"<string>\",\n        \"order\": \"<string>\"\n      }\n    }\n  ],\n  \"options\": {\n    \"timezone\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }

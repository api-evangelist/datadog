{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Vulnerabilities API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [

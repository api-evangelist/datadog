{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Entry API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Entry",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Create a New Entry for Your Service Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/integration/gcp/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new entry within Datadog for your STS enabled service account."
        }
      ]
    }
  ],
  "bundled": true
}
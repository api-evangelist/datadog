{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Read API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Read",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog List Read Roles for an Archive",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/logs/config/archives/:archive_id/readers",
            "params": [
              {
                "name": "archive_id",
                "value": "",
                "type": "path",
                "description": "The ID of the archive."
              }
            ]
          },
          "docs": "Returns all read roles a given archive is restricted to."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Runs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Run a Historical Job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/siem-historical-detections/jobs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Run a historical job."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Upload API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Upload Custom Costs File",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.{site}/api/v2/cost/custom_costs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Upload a Custom Costs file."
        },
        {
          "info": {
            "name": "Datadog Upload Idp Metadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/saml_configurations/idp_metadata",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Endpoint for uploading IdP metadata for SAML setup.\n\nUse this endpoint to upload or replace IdP metadata for SAML login configuration."
        }
      ]
    }
  ],
  "bundled": true
}
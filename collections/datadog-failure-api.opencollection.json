{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Failure API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Failure",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Get a List of Failure Events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/dora/failures",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Use this API endpoint to get a list of failure events."
        },
        {
          "info": {
            "name": "Datadog Get a Failure Event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/dora/failures/:failure_id",
            "params": [
              {
                "name": "failure_id",
                "value": "abc-123-def",
                "type": "path",
                "description": "The ID of the failure event."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Use this API endpoint to get a failure event."
        }
      ]
    }
  ],
  "bundled": true
}
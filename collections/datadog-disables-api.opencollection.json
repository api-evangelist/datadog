{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Disables API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Disables",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Disable a User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.{site}/api/v2/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The ID of the user."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Disable a user. Can only be used with an application key belonging\nto an administrator user."
        }
      ]
    }
  ],
  "bundled": true
}
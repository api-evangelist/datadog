        {
          "id": "9fa71d1d-1950-45f7-b9a6-afb97db725c7",
          "name": "Datadog Get Hourly Usage for Lambda Traced Invocations",
          "request": {
            "name": "Datadog Get Hourly Usage for Lambda Traced Invocations",
            "description": {
              "content": "Get hourly usage for Lambda traced invocations.\n**Note:** This endpoint has been deprecated.. Hourly usage data for all products is now available in the [Get hourly usage by product family API](https://docs.datadoghq.com/api/latest/usage-metering/#get-hourly-usage-by-product-family)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "usage",
                "lambda_traced_invocations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_hr",
                  "value": "<dateTime>",
                  "description": "(Required) Datetime in ISO-8601 format, UTC, precise to hour: `[YYYY-MM-DDThh]` for usage beginning at this hour."
                },
                {
                  "disabled": false,
                  "key": "end_hr",
                  "value": "<dateTime>",
                  "description": "Datetime in ISO-8601 format, UTC, precise to hour: `[YYYY-MM-DDThh]` for usage ending\n**before** this hour."
                }
              ],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json;datetime-format=rfc3339"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "DD-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },

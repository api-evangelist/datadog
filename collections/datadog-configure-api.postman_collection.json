                  "raw": "{\n  \"data\": {\n    \"id\": \"kafka.lag\",\n    \"type\": \"metric_bulk_configure_tags\",\n    \"attributes\": {\n      \"emails\": [\n        \"sue@example.com\",\n        \"bob@example.com\"\n      ],\n      \"exclude_tags_mode\": true,\n      \"include_actively_queried_tags_window\": 95.5,\n      \"override_existing_configurations\": true,\n      \"tags\": [\n        \"host\",\n        \"pod_name\",\n        \"is_shadow\"\n      ]\n    }\n  }\n}",
                  "options": {

      "item": [
        {
          "id": "dc45f3f0-100f-4594-bbe9-3c63de792bd0",
          "name": "Datadog Configure Tags for Multiple Metrics",
          "request": {
            "name": "Datadog Configure Tags for Multiple Metrics",
            "description": {
              "content": "Create and define a list of queryable tag keys for a set of existing count, gauge, rate, and distribution metrics.\nMetrics are selected by passing a metric name prefix. Use the Delete method of this API path to remove tag configurations.\nResults can be sent to a set of account email addresses, just like the same operation in the Datadog web app.\nIf multiple calls include the same metric, the last configuration applied (not by submit order) is used, do not\nexpect deterministic ordering of concurrent calls. The `exclude_tags_mode` value will set all metrics that match the prefix to\nthe same exclusion state, metric tag configurations do not support mixed inclusion and exclusion for tags on the same metric.\nCan only be used with application keys of users with the `Manage Tags for Metrics` permission.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "metrics",
                "config",
                "bulk-tags"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"id\": \"<string>\",\n    \"type\": \"metric_bulk_configure_tags\",\n    \"attributes\": {\n      \"emails\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"exclude_tags_mode\": \"<boolean>\",\n      \"include_actively_queried_tags_window\": \"<double>\",\n      \"override_existing_configurations\": \"<boolean>\",\n      \"tags\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "46ee4de7-2165-46c6-92ad-6ead633ea6b8",

          "id": "849a7536-1808-4559-818d-87ec295df19e",
          "name": "Datadog Download the Workload Protection Policy",
          "request": {
            "name": "Datadog Download the Workload Protection Policy",
            "description": {
              "content": "The download endpoint generates a Workload Protection policy file from your currently active\nWorkload Protection agent rules, and downloads them as a `.policy` file. This file can then be deployed to\nyour agents to update the policy running in your environment.\n\n**Note**: This endpoint is not available for the Government (US1-FED) site. Please reference the (US1-FED) specific resource below.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "remote_config",
                "products",
                "cws",
                "policy",
                "download"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }

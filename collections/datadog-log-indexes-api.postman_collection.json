      "item": [
        {
          "id": "4686dd7c-06dd-4add-b39c-7bee7bc5beb8",
          "name": "Datadog List Log Indexes",
          "request": {
            "name": "Datadog List Log Indexes",
            "description": {
              "content": "Returns the list of configured log indexes for your Datadog organization. Each index defines a filter for which logs to include, a daily retention policy, and log volume limits. Indexes are evaluated in order, and each log can match at most one index. Index configurations affect log retention, querying capabilities, and cost.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "logs",
                "config",
                "indexes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

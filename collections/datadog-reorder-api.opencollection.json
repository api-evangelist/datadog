{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Reorder API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reorder",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Reorder Groups",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{subdomain}.{site}/api/v2/sensitive-data-scanner/config",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reorder the list of groups."
        }
      ]
    }
  ],
  "bundled": true
}
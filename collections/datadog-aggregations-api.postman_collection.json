          "name": "Datadog List Active Tags and Aggregations",
          "request": {
            "name": "Datadog List Active Tags and Aggregations",
            "description": {
              "content": "List tags and aggregations that are actively queried on dashboards, notebooks, monitors, the Metrics Explorer, and using the API for a given metric name.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "metrics",
                ":metric_name",
                "active-configurations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "window[seconds]",
                  "value": "<long>",
                  "description": "The number of seconds of look back (from now).\nDefault value is 604,800 (1 week), minimum value is 7200 (2 hours), maximum value is 2,630,000 (1 month)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "metric_name",
                  "description": "(Required) The name of the metric."
                },
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [

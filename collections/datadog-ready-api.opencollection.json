{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Ready API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ready",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Get List of Aws Log Ready Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/integration/aws/logs/services"
          },
          "docs": "Get a list of AWS services that can send logs to Datadog."
        }
      ]
    }
  ],
  "bundled": true
}
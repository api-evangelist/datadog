{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Pages API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Create On-call Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/on-call/pages",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Trigger a new On-Call Page.\n"
        },
        {
          "info": {
            "name": "Datadog Acknowledge On-call Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/on-call/pages/:page_id/acknowledge",
            "params": [
              {
                "name": "page_id",
                "value": "15e74b8b-f865-48d0-bcc5-453323ed2c8f",
                "type": "path",
                "description": "The page ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Acknowledges an On-Call Page.\n"
        },
        {
          "info": {
            "name": "Datadog Escalate On-call Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/on-call/pages/:page_id/escalate",
            "params": [
              {
                "name": "page_id",
                "value": "15e74b8b-f865-48d0-bcc5-453323ed2c8f",
                "type": "path",
                "description": "The page ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Escalates an On-Call Page.\n"
        },
        {
          "info": {
            "name": "Datadog Resolve On-call Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/on-call/pages/:page_id/resolve",
            "params": [
              {
                "name": "page_id",
                "value": "15e74b8b-f865-48d0-bcc5-453323ed2c8f",
                "type": "path",
                "description": "The page ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Resolves an On-Call Page.\n"
        }
      ]
    }
  ],
  "bundled": true
}
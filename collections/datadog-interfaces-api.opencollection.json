{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Interfaces API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Interfaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Get the List of Interfaces of the Device",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/ndm/interfaces",
            "params": [
              {
                "name": "device_id",
                "value": "example:1.2.3.4",
                "type": "query",
                "description": "The ID of the device to get interfaces from."
              },
              {
                "name": "get_ip_addresses",
                "value": "true",
                "type": "query",
                "description": "Whether to get the IP addresses of the interfaces."
              }
            ]
          },
          "docs": "Get the list of interfaces of the device."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Generate API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Generate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Generate a New External Id",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.{site}/api/v2/integration/aws/generate_new_external_id"
          },
          "docs": "Generate a new external ID for AWS role-based authentication."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Delegate API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Delegate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog List Delegate Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/integration/gcp/sts_delegate"
          },
          "docs": "List your Datadog-GCP STS delegate account configured in your Datadog account."
        }
      ]
    }
  ],
  "bundled": true
}
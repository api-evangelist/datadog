{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Mute API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Mute",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog Mute or Unmute a Batch of Findings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{subdomain}.{site}/api/v2/posture_management/findings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "DD-API-KEY",
              "value": "{{DD-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Mute or unmute findings."
        }
      ]
    }
  ],
  "bundled": true
}
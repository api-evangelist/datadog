  "info": {
    "_postman_id": "9c5bc356-2117-4895-b1f8-91be2eeeda2c",
    "name": "Datadog Events API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Datadog Events API allows you to programmatically post events to the Events Explorer and fetch events from the Events Explorer. Events represent notable changes or activity within your monitored infrastructure such as code deployments, configuration changes, alert state transitions, and custom business events. Events are stored for 180 days and can be correlated with metrics and logs for root cause analysis. The v2 API supports richer event models with attributes and more powerful search capabilities.\n\nContact Support:\n Name: Datadog Support",
      "type": "text/plain"
    }
  }

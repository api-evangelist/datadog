        {
          "id": "fc7fe8b2-33c6-41ea-8d4d-ccad5302bf6d",
          "name": "Datadog Get a List of Events",
          "request": {
            "name": "Datadog Get a List of Events",
            "description": {
              "content": "Returns a paginated list of events from the Events Explorer matching the specified search criteria. Supports filtering by text search, tags, time range, sources, alert types, and priorities. Results are sorted by timestamp in descending order by default. Use cursor-based pagination for large result sets. The v2 API provides richer event attributes and improved search capabilities compared to v1.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter[query]",
                  "value": "<string>",
                  "description": "A Datadog events search query to filter events (e.g., source:aws status:error)"
                },
                {
                  "disabled": false,
                  "key": "filter[from]",
                  "value": "<string>",
                  "description": "The start of the search time range as an ISO 8601 timestamp or relative time (e.g., now-1h)"
                },
                {
                  "disabled": false,
                  "key": "filter[to]",
                  "value": "<string>",
                  "description": "The end of the search time range as an ISO 8601 timestamp or relative time (e.g., now)"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "The sort order for events, either ascending or descending by timestamp"
                },
                {
                  "disabled": false,
                  "key": "page[cursor]",
                  "value": "<string>",
                  "description": "A cursor token from a previous response to retrieve the next page of events"
                },
                {
                  "disabled": false,
                  "key": "page[limit]",
                  "value": "10",
                  "description": "The maximum number of events to return per page (default 10, max 1000)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

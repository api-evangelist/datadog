  "item": [
    {
      "id": "69205f75-31c5-413b-ad36-c390e21cc83b",
      "name": "Metric Metadata",
      "description": {
        "content": "View and manage metric metadata and active metrics",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8c348021-3259-43ee-b488-8da186205948",
          "name": "Datadog List Active Metrics",
          "request": {
            "name": "Datadog List Active Metrics",
            "description": {
              "content": "Returns the list of actively reporting metric names for a given hour. Optionally filters by host and metric name prefix. Metrics are considered active if they reported at least one data point within the last 48 hours. Useful for metric discovery and auditing.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<long>",
                  "description": "(Required) POSIX timestamp (seconds) indicating the start of the time window to query active metrics"
                },
                {
                  "disabled": false,
                  "key": "host",
                  "value": "<string>",
                  "description": "Filter metrics by the hostname that is actively reporting the metric"
                },
                {
                  "disabled": false,
                  "key": "tag_filter",
                  "value": "<string>",
                  "description": "Filter metrics by tag key or key:value pair (e.g., env:prod)"
                }
              ],
              "variable": [
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                },
                {
                  "description": "The subdomain where the API is deployed.",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [

      "item": [
        {
          "id": "a93c27e3-9fc1-4d9d-adc5-ddffefbe1696",
          "name": "Datadog Mute a Monitor",
          "request": {
            "name": "Datadog Mute a Monitor",
            "description": {
              "content": "Mutes the specified monitor to suppress alert notifications for all groups or specific scopes. Optionally specify an end time after which the monitor automatically unmutes. While muted, the monitor continues to evaluate the query but does not send alert notifications. Useful for planned maintenance or known issues.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "monitor",
                ":monitor_id",
                "mute"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "monitor_id",
                  "description": "(Required) The unique numeric ID of the monitor to operate on"
                },
                {
                  "description": "The regional site for Datadog customers. (This can only be one of datadoghq.com,us3.datadoghq.com,us5.datadoghq.com,ap1.datadoghq.com,datadoghq.eu,ddog-gov.com)",

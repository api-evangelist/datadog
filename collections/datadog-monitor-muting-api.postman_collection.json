          "request": {
            "name": "Datadog Unmute a Monitor",
            "description": {
              "content": "Unmutes a previously muted monitor to resume alert notifications. Optionally specify a scope to unmute only specific groups. If no scope is specified, the monitor is unmuted globally across all groups. Notifications resume immediately for any groups that are in an alert or warning state.",
              "type": "text/plain"
            },

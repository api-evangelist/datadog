{
  "opencollection": "1.0.0",
  "info": {
    "name": "Datadog Account Standard API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DD-API-KEY",
      "value": "{{DD-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Standard",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Datadog List Standard Patterns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.{site}/api/v2/sensitive-data-scanner/config/standard-patterns"
          },
          "docs": "Returns all standard patterns."
        }
      ]
    }
  ],
  "bundled": true
}